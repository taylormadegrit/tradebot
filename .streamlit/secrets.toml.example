# Copy to .streamlit/secrets.toml for local runs, or paste into the
# "Secrets" box in the Streamlit Community Cloud app settings.
# ALL OPTIONAL — the app works with none of these (it falls back to the
# bundled sample data and a rule-based news read).

# OANDA v20 practice token — enables the "OANDA (live)" data source for
# XAUUSD / US30 / US100. Get a free one at oanda.com (practice account).
OANDA_TOKEN = ""
OANDA_ENV = "practice"

# Anthropic API key — upgrades the news "Impact" line from a keyword rule
# to a one-sentence Claude read. From console.anthropic.com.
ANTHROPIC_API_KEY = ""
