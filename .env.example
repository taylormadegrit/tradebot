# Copy this file to ".env" and fill in your own values. .env is gitignored.
# ============================================================================

# --- OANDA (REQUIRED) -- each teammate uses their OWN practice account -------
# Get these from: oanda.com -> open a free "practice" (demo) account ->
#   Hub -> Manage API Access -> generate a personal access token.
# The account id is auto-discoverable, but you can paste it here too
# (format 101-001-XXXXXXXX-001). Leave it blank and the bot will look it up.
OANDA_TOKEN=
OANDA_ENV=practice
OANDA_ACCOUNT_ID=

# --- Discord (OPTIONAL) -- for posting alerts to a channel -----------------
# The team shares ONE bot. Ask the owner for DISCORD_BOT_TOKEN.
# DISCORD_CHANNEL_ID is the channel YOU want your alerts in
# (Discord: enable Developer Mode -> right-click channel -> Copy Channel ID).
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# --- Claude (OPTIONAL) -- if set, each news headline gets a real one-line
# "what could this do to the price" read from Claude. Without it the bot falls
# back to a rule-based read. Key from console.anthropic.com.
ANTHROPIC_API_KEY=

# --- TradeLocker / broker (OPTIONAL) -- only if you trade through TradeLocker
# Leave blank unless you have your own TradeLocker broker login.
TL_USERNAME=
TL_PASSWORD=
TL_SERVER=
TL_ENVIRONMENT=https://demo.tradelocker.com
